{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User Registration Response",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "username": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "email", "username", "created_at"]
}
